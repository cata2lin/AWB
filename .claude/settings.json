{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(./venv/Scripts/python.exe*)",
      "Bash(backend/venv/Scripts/*)",
      "Bash(./venv/Scripts/pytest.exe*)",
      "Bash(./venv/Scripts/ruff.exe*)",
      "Bash(./venv/Scripts/pip.exe install*)",
      "Bash(curl.exe -s http://127.0.0.1:8000*)",
      "Bash(curl.exe -s -o NUL -w*)",
      "Bash(curl.exe -s http://localhost:5173*)",
      "Bash(taskkill *python.exe*)",
      "Bash(taskkill *node.exe*)"
    ],

    "deny": [
      "Bash(psql *38.242.226.83*)",
      "Bash(psql -h 38.242.226.83*)",

      "Bash(pip uninstall fastapi*)",
      "Bash(pip uninstall sqlalchemy*)",
      "Bash(pip uninstall pydantic*)",
      "Bash(pip uninstall uvicorn*)",
      "Bash(pip uninstall pypdf*)",
      "Bash(pip uninstall reportlab*)",
      "Bash(pip uninstall httpx*)",
      "Bash(pip uninstall apscheduler*)",

      "Bash(npm uninstall react*)",
      "Bash(npm uninstall vite*)",
      "Bash(npm uninstall sonner*)",
      "Bash(npm uninstall @tanstack/react-query*)",
      "Bash(npm uninstall axios*)",
      "Bash(npm uninstall tailwindcss*)"
    ]
  }
}
